<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block sensitive files at the project root.
    RewriteRule ^(\.env|composer\.(json|lock|phar)|artisan|phpunit\.xml)(/|$) - [F,L]
    RewriteRule ^(\.git|\.cursor|app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L]

    # Leave requests that are already under /public alone.
    RewriteCond %{REQUEST_URI} ^/federalmanpower/public(/|$) [NC]
    RewriteRule ^ - [L]

    # Empty path → Laravel front controller
    RewriteRule ^$ /federalmanpower/public/index.php [L]

    # Absolute path rewrite (LiteSpeed-friendly)
    RewriteRule ^(.*)$ /federalmanpower/public/$1 [L]
</IfModule>

DirectoryIndex index.php
