<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /federalmanpower/

    # Already under /public — do not rewrite again.
    RewriteRule ^public(/|$) - [L]

    # Send everything else into the Laravel public folder.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

DirectoryIndex public/index.php index.php
