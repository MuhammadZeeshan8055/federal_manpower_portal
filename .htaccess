<IfModule mod_rewrite.c>
    RewriteEngine On

    # Shared hosting: send traffic into /public (works at domain root or in a subfolder).
    # Per-directory match — skip if already under public/ to avoid a rewrite loop.
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
